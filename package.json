{
  "name": "health-web-app",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy-conscious personal health, meal, and habit tracking PWA.",
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.16.0",
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --concurrency off --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"staging-e2e/**/*.ts\" \"tests/**/*.ts\" \"*.config.{ts,mts,mjs}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "env:check": "node scripts/validate-env.mjs --environment local"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.4.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.3",
    "eslint-config-next": "16.2.10",
    "happy-dom": "20.11.0",
    "postcss": "8.5.26",
    "prettier": "3.9.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
