# 実装仕様書 13.1節「環境変数（.env.example）」の一覧に対応するテンプレート。
# 実値は .env.local など Git 管理外のファイルへ置き、ここには絶対に書かないこと。
# NEXT_PUBLIC_ を付けてよいのは公開しても安全な設定のみ（実装仕様書 9.2節）。

# --- アプリ共通 ---
# 公開URL（リダイレクトと絶対リンクの基準）。例: http://localhost:3000
#
# 【本番・ステージングでは必須】
# 実装仕様書 7章の same-origin 検証は、この値だけを「アプリのオリジン」として
# 信頼する。X-Forwarded-Host / X-Forwarded-Proto は詐称されうるため参照しない。
# 未設定の場合、状態変更API（削除・出力を含む）は比較対象が決まらないため
# 常に 403 SAME_ORIGIN_REQUIRED を返す（フェイルクローズ）。
# ローカル開発でも http://localhost:3000 を設定しておくこと。
NEXT_PUBLIC_APP_URL=
# 資格情報不要のデモモードを有効化するか（true / false）。
NEXT_PUBLIC_DEMO_MODE_ENABLED=
# 利用者がタイムゾーンを選ぶ前の既定 IANA タイムゾーン。例: Asia/Tokyo
NEXT_PUBLIC_DEFAULT_TIME_ZONE=

# --- Supabase ---
# ブラウザSDKへ公開するプロジェクトURL。
NEXT_PUBLIC_SUPABASE_URL=
# ブラウザSDKへ公開する publishable key（RLSは必須のまま）。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー専用の秘密鍵。NEXT_PUBLIC_ を付けないこと。
SUPABASE_SECRET_KEY=

# --- Google Calendar ---
# サーバー側の認可ルートのみが使用する OAuth 資格情報。
# リダイレクトURIは Google Cloud Console の登録値と完全一致させること。
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
# サーバー専用の base64url 32バイト AES-256-GCM 鍵。Git の外で生成すること。
# 例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# ローカル／テスト用のプロバイダー選択子。`fake` のみが疑似プロバイダーを有効化する。
# 本番は `fake` を拒否する。
GOOGLE_CALENDAR_PROVIDER=
# ローカル／テスト／ステージングのUI選択子（真偽値ではなくプロバイダー選択子）。
NEXT_PUBLIC_GOOGLE_CALENDAR_DEMO_PROVIDER=

# --- Push（Web Push / VAPID）---
# 公開してよいのは公開鍵のみ。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# ローカル開発・テストでのみメモリ内プロバイダーを選択する。本番は未設定にすること。
PUSH_PROVIDER=

# --- AI アシスタント ---
# 既定はサーバー専用のゼロコスト方針。鍵をコミットしないこと。
AI_COST_MODE=zero-cost
AI_DEFAULT_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=ollama,deterministic
AI_ALLOW_PAID_PROVIDERS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FREE_TIER_ONLY=true
GEMINI_DAILY_REQUEST_CAP=
GEMINI_MINUTE_REQUEST_CAP=
GEMINI_DAILY_INPUT_TOKEN_CAP=
GEMINI_DAILY_OUTPUT_TOKEN_CAP=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_ENABLED=false
AI_MAX_CONTEXT_MESSAGES=12
AI_MAX_TOOL_CALLS=3
AI_REQUEST_TIMEOUT_MS=20000
AI_EXTERNAL_DATA_CONSENT_REQUIRED=true

# --- 食事画像解析 ---
# アシスタントと同じゼロコスト方針。鍵・モデル・URLはすべてサーバー専用。
FOOD_VISION_ENABLED=true
FOOD_VISION_DEFAULT_PROVIDER=gemini
FOOD_VISION_FALLBACK_PROVIDERS=ollama,manual
FOOD_VISION_MAX_FILE_BYTES=6291456
FOOD_VISION_MAX_PIXELS=12000000
FOOD_VISION_MAX_DIMENSION=1600
FOOD_VISION_DAILY_ANALYSIS_CAP=20
FOOD_VISION_REQUEST_TIMEOUT_MS=20000
FOOD_VISION_MAX_ITEMS=12
FOOD_IMAGE_STORAGE_MODE=ephemeral
FOOD_IMAGE_RETENTION_HOURS=24
FOOD_IMAGE_BUCKET=food-images-private
# 無料枠かつ画像対応の Gemini モデルのみ選択できる。
GEMINI_VISION_MODEL=gemini-2.5-flash
# Ollama はローカル／自己ホスト専用。利用者が指定できるURLを渡さないこと。
OLLAMA_VISION_MODEL=
# テスト専用。本番はクライアントから渡されても拒否する。
FOOD_VISION_TEST_PROVIDER=

# --- ジョブ ---
# 通知配信などスケジュール実行の認証に使うサーバー専用シークレット。
CRON_SECRET=
